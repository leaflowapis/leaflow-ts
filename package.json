      "types": "./dist/src/type/error/v1/index.d.ts",
      "default": "./dist/src/type/error/v1/index.js"
    },
    "./type/identity/v1": {
      "types": "./dist/src/type/identity/v1/index.d.ts",
      "default": "./dist/src/type/identity/v1/index.js"
    },
    "./type/money/v1": {
      "types": "./dist/src/type/money/v1/index.d.ts",
