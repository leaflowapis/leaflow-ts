{
  "name": "@leaflow/sdk",
  "version": "0.0.0",
  "description": "Leaflow 平台 API 的 TypeScript SDK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leaflowapis/leaflow-ts.git"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./routes": {
      "types": "./dist/routes.d.ts",
      "default": "./dist/routes.js"
    },
    "./*": {
      "types": "./dist/*/index.d.ts",
      "default": "./dist/*/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "generate": "orval",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "format:check": "prettier --check orval.config.mjs src"
  },
  "devDependencies": {
    "orval": "8.39.0",
    "typescript": "5.9.3",
    "prettier": "3.6.2",
    "@types/node": "22.20.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "4.6.5"
  }
}
