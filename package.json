    "./type/security/v1": {
      "types": "./dist/src/type/security/v1/index.d.ts",
      "default": "./dist/src/type/security/v1/index.js"
    }
  },
  "files": [
    "dist/gen",
    "dist/src"
  ],
  "sideEffects": false,
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run build",
    "format:check": "prettier --check scripts src"
  },
  "devDependencies": {
    "orval": "8.39.0",
    "typescript": "5.9.3",
    "yaml": "2.8.1",
    "prettier": "3.6.2",
    "@types/node": "22.20.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "4.6.5"
  }
