{
  "name": "@leaflow/sdk",
  "version": "0.0.0",
  "description": "Leaflow 平台 API 的 TypeScript SDK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leaflowapis/leaflow-ts.git"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./routes": {
      "types": "./dist/gen/routes.d.ts",
      "default": "./dist/gen/routes.js"
    },
    "./account/v1": {
      "types": "./dist/src/account/v1/index.d.ts",
      "default": "./dist/src/account/v1/index.js"
    },
    "./assistant/v1": {
      "types": "./dist/src/assistant/v1/index.d.ts",
      "default": "./dist/src/assistant/v1/index.js"
    },
    "./billing/account/v1": {
      "types": "./dist/src/billing/account/v1/index.d.ts",
      "default": "./dist/src/billing/account/v1/index.js"
    },
    "./billing/catalog/v1": {
      "types": "./dist/src/billing/catalog/v1/index.d.ts",
      "default": "./dist/src/billing/catalog/v1/index.js"
    },
    "./billing/project/v1": {
      "types": "./dist/src/billing/project/v1/index.d.ts",
